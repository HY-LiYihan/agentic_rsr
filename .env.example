# Local inference is the default. Select remote explicitly to use TCP services.
VGGT_OMEGA_BACKEND=local
SAM3_BACKEND=local
VGGT_OMEGA_DEVICE=cuda
SAM3_DEVICE=cuda

# Remote VGGT-Ω service. Keep real host/IP values in the untracked .env file.
VGGT_OMEGA_HOST=
VGGT_OMEGA_PORT=
VGGT_OMEGA_PROTOCOL=tcp

# Remote SAM3 service. Keep real host/IP values in the untracked .env file.
SAM3_HOST=
SAM3_PORT=
SAM3_PROTOCOL=tcp

# Local model directories. Weights are never committed to this repository.
VGGT_OMEGA_MODEL_DIR=./model/vggt_omega
SAM3_MODEL_DIR=./model/sam3
CUDA_VISIBLE_DEVICES=0
MODEL_CACHE_DIR=./model/cache

# Optional Blender executable override. Otherwise finds blender on PATH,
# then the macOS Blender.app if running on macOS.
# BLENDER_BIN=/path/to/blender
